# Public site origin for absolute metadata URLs (canonicals, OG images,
# sitemap, robots). Optional: production builds default to
# https://drawmytrip.click and Vercel previews use their own address.
# Set it only to override (a staging domain, say).
NEXT_PUBLIC_SITE_URL=

# Search engine ownership tags (optional). The token from Google Search
# Console ("HTML tag" method) and Bing Webmaster Tools; unset adds no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# AI trip generation — any OpenAI-compatible endpoint (server-side only).
# e.g. Ollama: AI_BASE_URL=http://localhost:11434/v1 AI_MODEL=qwen3:14b
# Prefer open-weight models under an OSI license (Qwen, gpt-oss, Mistral).
AI_BASE_URL=
AI_MODEL=
# Optional; omitted from requests when empty (local Ollama needs none).
AI_API_KEY=
# Optional, sent only when set. For reasoning models (e.g. gpt-oss on Groq):
# low|medium|high, and a cap high enough for the JSON after reasoning.
AI_REASONING_EFFORT=
AI_MAX_TOKENS=

# Admin Health page (optional). Same value on the admin project; unset makes
# /api/health/services answer 404. 32+ random characters.
HEALTH_CHECK_SECRET=

# Upstash Redis — shared trip snapshots + rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Map basemap (optional). Defaults to public OpenFreeMap; set to a
# self-hosted MapLibre style URL (OpenFreeMap, Protomaps, ...) to replace it.
# The CSP allows only this URL's origin, so tiles/glyphs/sprites must share it.
NEXT_PUBLIC_MAP_STYLE_URL=

# Exchange rates for budget display (optional). Defaults to Frankfurter
# (open-source ECB rates, no key); point at a self-hosted instance with
# the same `/latest?base=USD` response shape to replace it.
RATES_API_URL=

# Better Stack server logs (optional — logs still print to the console when
# unset). Server-only: never prefix these with NEXT_PUBLIC_.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_URL=

# Sentry monitoring (optional — everything is a no-op when unset).
# DSN is safe to expose; it only accepts events.
NEXT_PUBLIC_SENTRY_DSN=
# CI-only, for source-map upload:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Tester feedback button (optional, temporary). Userback project token from
# Userback > Settings > Install. Set it only on the environments under test
# (inlined at build time, so redeploy after changing it); unset it to hide the button.
NEXT_PUBLIC_USERBACK_TOKEN=

# Affiliate booking links (optional). Each is the full URL from your partner
# dashboard, https only, with {city}, {country}, {checkin}, {checkout} placeholders
# (dates are YYYY-MM-DD, empty on undated trips). A kind left empty is hidden.
# Public by nature (inlined at build time), so never put a secret in them.
NEXT_PUBLIC_AFFILIATE_STAY_URL=
NEXT_PUBLIC_AFFILIATE_ACTIVITY_URL=
NEXT_PUBLIC_AFFILIATE_ESIM_URL=
NEXT_PUBLIC_AFFILIATE_INSURANCE_URL=
