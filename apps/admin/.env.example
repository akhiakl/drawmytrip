# DrawMyTrip admin. Any of the first four unset: every page answers 404
# (the health route stays 200).
# GitHub OAuth App callback: https://<admin host>/api/auth/callback
# (one OAuth app per host; add http://localhost:3001/api/auth/callback for dev).
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user ids allowed in.
ADMIN_GITHUB_IDS=
# 32+ random characters; signs the session cookie.
ADMIN_SESSION_SECRET=

# Same Upstash database as the web app.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel sends it as a bearer token to the daily usage cron (/api/collect).
CRON_SECRET=

# Usage collectors (optional; a provider without them shows "Not connected").
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
UPSTASH_EMAIL=
UPSTASH_API_KEY=
UPSTASH_DATABASE_ID=

# Health page: the site's per-service check. Same secret as the web project.
HEALTH_CHECK_SECRET=
# Optional; defaults to https://www.drawmytrip.click.
WEB_ORIGIN=
